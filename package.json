{
  "name": "custom-mcp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Custom MCP server with external API integration",
  "scripts": {
    "start": "node src/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node src/index.js",
    "build": "rm -rf dist && mkdir -p dist && cp src/index.js dist/index.js",
    "start:dist": "node dist/index.js",
    "start:dist:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart custom-mcp-api --update-env",
    "pm2:stop": "pm2 stop custom-mcp-api",
    "pm2:logs": "pm2 logs custom-mcp-api"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  }
}
